#!/bin/bash
set -uxo pipefail
exec > /var/log/user-data.log 2>&1

# ==================================================================
# WEB 부팅 스크립트 (Docker Hub + Watchtower 기반 CI/CD)
#
# 배포 시퀀스:
#   1) main 에 push
#   2) GitHub Actions 가 이미지 빌드 -> Docker Hub 에 :latest 푸시
#   3) 각 WEB 인스턴스의 Watchtower 가 폴링으로 다이제스트 변경 감지
#   4) 새 이미지 pull 후 컨테이너 교체
#
# 이 스크립트는 부팅 시 두 가지만 한다.
#   - Docker 설치 + Docker Hub 로그인
#   - web 컨테이너와 watchtower 컨테이너 기동
# 이후 배포는 Terraform 과 무관하게 GitHub 쪽에서만 돌아간다.
#
# ⚠️ IMDS hop limit 주의
#   compute.tf 의 imds_v2.http_put_response_hop_limit = 1 이다.
#   컨테이너 내부(브리지 네트워크)에서 169.254.169.254 를 호출하면 홉이 하나
#   늘어 실패한다. 이 설계는 AWS 호출(ssm get-parameter)을 전부 호스트에서
#   하고 컨테이너에는 결과만 넘기므로 1 로 충분하다.
#   컨테이너 안에서 aws CLI 나 SDK 를 쓰게 되면 그때 2 로 올려야 한다.
# ==================================================================

export DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------
# apt 재시도 래퍼
#
# 부팅 직후에는 cloud-init 과 unattended-upgrades 가 apt lock 을 잡고 있다.
# 그 사이에 apt-get 을 부르면 이렇게 실패한다:
#   E: Could not get lock /var/lib/apt/lists/lock. It is held by process N (python3)
#   E: Package 'docker-ce' has no installation candidate
#
# 이 스크립트는 set -e 가 아니므로(-uxo pipefail 뿐) 실패해도 그냥 진행한다.
# 그래서 증상이 한참 뒤 "docker: command not found" 로 나타나 원인을 찾기 어렵다.
# 실제로 4 대 중 1 대에서 이 레이스가 터졌다.
#
# DPkg::Lock::Timeout 은 dpkg 프런트엔드 lock 만 커버하고 lists lock 은
# 커버하지 않으므로, 옵션과 재시도 루프를 함께 쓴다.
# 끝까지 실패하면 조용히 넘어가지 않고 즉시 중단한다.
# ------------------------------------------------------------------
apt_retry() {
  for attempt in $(seq 1 30); do
    if apt-get -o DPkg::Lock::Timeout=120 "$@"; then
      return 0
    fi
    echo "apt-get $1 실패 (시도 $attempt/30). 10 초 후 재시도한다."
    sleep 10
  done
  echo "FATAL: apt-get $1 가 30 회 재시도 후에도 실패했다. 부팅을 중단한다."
  exit 1
}

apt_retry update
apt_retry install -y ca-certificates curl gnupg unzip chrony

# ------------------------------------------------------------------
# 시각 동기화 (chrony + Amazon Time Sync Service) 와 타임존
#
# ⚠️ Docker 설치보다 "먼저" 하는 순서가 중요하다.
#   시계가 어긋나면 TLS 인증서의 유효기간 검증과 AWS SigV4 서명이 함께
#   깨진다. 증상은 원인에서 멀어 보이는 형태로만 나온다:
#     docker pull -> x509: certificate has expired or is not yet valid
#     aws ssm     -> InvalidSignatureException / SignatureDoesNotMatch
#   토큰이나 IAM 권한을 먼저 의심하게 되는 실패라, 시계부터 맞추고 나머지를
#   시작한다. 부팅 직후 EC2 시계는 보통 맞지만 항상 그렇지는 않다.
#
# 169.254.169.123 : Amazon Time Sync Service.
#   링크로컬 주소라 NAT 게이트웨이도 인터넷도 타지 않고, 보안그룹/NACL 의
#   영향도 받지 않는다. 프라이빗 서브넷에 있는 이 인스턴스들이 공개 NTP
#   풀(ntp.ubuntu.com)에 나갈 필요가 없어진다. minpoll/maxpoll 4(16 초)는
#   AWS 권장값으로, 로컬 주소라 폴링이 잦아도 비용이 들지 않는다.
#
# Ubuntu 22.04 기본은 systemd-timesyncd 인데 SNTP 클라이언트라 보정이 거칠고
# (한 번에 시각을 점프시킨다) 드리프트 보상을 하지 않는다. chrony 패키지가
# timesyncd 를 밀어내지만, 둘이 동시에 살아 있으면 서로 시계를 되돌리므로
# 명시적으로 꺼 둔다.
# ------------------------------------------------------------------
systemctl disable --now systemd-timesyncd || true

mkdir -p /etc/chrony/conf.d
cat > /etc/chrony/conf.d/amazon-time-sync.conf <<'CHRONY'
server 169.254.169.123 prefer iburst minpoll 4 maxpoll 4
CHRONY

# 위 파일은 chrony.conf 에 confdir 지시자가 있어야 읽힌다. Ubuntu 22.04 의
# chrony 패키지 기본 설정에는 들어 있지만, 빠져 있으면 우리 설정이 아무 경고
# 없이 무시되고 기본 ntp.ubuntu.com 풀만 쓰게 된다. 확인해서 없으면 채운다.
grep -q '^confdir /etc/chrony/conf.d' /etc/chrony/chrony.conf ||
  echo 'confdir /etc/chrony/conf.d' >> /etc/chrony/chrony.conf

systemctl enable chrony
systemctl restart chrony

# 호스트 타임존. /etc/localtime 이 여기서 갈리고, 아래 컨테이너들은 이 파일을
# 읽기 전용으로 마운트받는다.
timedatectl set-timezone ${timezone}

# 첫 동기화를 최대 120 초(12 회 x 10 초)까지 기다린다. 실패해도 중단하지는
# 않는다 — 부팅 시계가 이미 맞는 경우가 대부분이라 여기서 죽이면 득보다
# 실이 크다. 다만 위에 적은 증상이 나오면 이 로그부터 확인할 것.
chronyc waitsync 12 0.1 || echo "WARN: NTP 첫 동기화가 120 초 안에 안 끝났다. 계속 진행한다."
chronyc tracking
timedatectl status

# ------------------------------------------------------------------
# Docker (공식 저장소) — 버전 고정: ${docker_version}
# Ubuntu 기본 저장소의 docker.io 는 버전이 낡아 공식 저장소를 쓴다.
# CVE-2026-34040 실습이 특정 데몬 API 세대(29.3.x)를 전제하므로 latest 대신 고정한다.
# ------------------------------------------------------------------
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg |
  gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] \
https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
  > /etc/apt/sources.list.d/docker.list

apt_retry update

# madison 출력: "docker-ce | 5:29.3.0-1~ubuntu.22.04~jammy | <repo>" — 세 번째 필드가
# apt 에 넣을 정확한 버전 문자열이다. 버전 경계를 위해 앞뒤 구분자([:~-]/[-~])까지 매칭.
DOCKER_PKG_VERSION="$(apt-cache madison docker-ce \
  | awk -v v="${docker_version}" '$3 ~ ("[:~-]" v "[-~]") {print $3; exit}')"
if [ -z "$DOCKER_PKG_VERSION" ]; then
  echo "FATAL: docker-ce ${docker_version} 를 apt 레포에서 찾지 못했다. 사용 가능한 버전:"
  apt-cache madison docker-ce | awk '{print $3}'
  exit 1
fi
echo "pinning docker-ce/docker-ce-cli to $DOCKER_PKG_VERSION"
apt_retry install -y \
  docker-ce="$DOCKER_PKG_VERSION" \
  docker-ce-cli="$DOCKER_PKG_VERSION" \
  containerd.io
# unattended-upgrades 가 핀을 되돌리지 않게 hold.
apt-mark hold docker-ce docker-ce-cli

# ------------------------------------------------------------------
# 컨테이너 로그 로테이션
#
# Docker 기본 json-file 드라이버는 크기 제한이 없다. nginx access log 가
# stdout 으로 나가 그대로 쌓이므로, 두면 30GB 루트 볼륨이 결국 찬다.
# WATCHTOWER_CLEANUP 은 옛 "이미지" 만 지우지 로그는 건드리지 않는다.
#
# 컨테이너당 최대 30MB(10MB x 3)로 제한한다.
# daemon.json 은 데몬 기동 시 읽히므로 restart 가 필요하다.
# ------------------------------------------------------------------
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'DAEMON'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
DAEMON

systemctl enable docker
systemctl restart docker

%{ if authz_enabled ~}
# ==================================================================
# [모의해킹 실습] Docker AuthZ 플러그인 (OPA) — enable_docker_authz_lab=true 일 때만 렌더링
# 데몬 API 에 닿는 통로는 Watchtower 소켓 마운트뿐(nginx 컨테이너는 소켓 안 뭄) = 사실상 root.
# AuthZ 플러그인이 그 API 호출을 Rego 정책으로 allow/deny 한다.
#
# ⚠️ 순서(락아웃 방지): install/enable → "확실히 enabled 일 때만" daemon.json 배선 → restart.
#    반영 후 데몬 비정상이면(정책 미로딩 등) daemon.json 을 자동 롤백한다.
# ⚠️ 정책 경로/마운트는 플러그인 버전마다 다를 수 있다. 기본 마운트가 /etc/docker/authz 를
#    못 집으면 `docker plugin set ${opa_authz_plugin} ...` 로 맞출 것(팀 몫. variables.tf 참고).
# ==================================================================
mkdir -p /etc/docker/authz

# 베이스라인 정책: 기본 거부(default deny) + Watchtower CI/CD 수명주기만 allow.
# fleet 안전(부팅 시 docker login·앱/Watchtower 컨테이너 생성·docker info)을 깨지 않으면서,
# privileged/호스트 루트 바인드 같은 "소켓으로 호스트 장악" 경로만 기본 거부로 남긴다.
#
# ⚠️ CVE-2026-34040 데모의 축: 아래 '컨테이너 생성' allow 는 요청 "본문"(Privileged/루트
#    바인드)을 보고 안전 여부를 판정한다. Docker 29.3.0 은 1MB 초과 본문을 플러그인에
#    닿기 전에 버리므로, 패딩한 생성 요청은 플러그인 눈에 '본문 없는(=안전한) 생성'으로
#    보여 이 allow 를 통과하고 데몬은 실제 본문대로 privileged 컨테이너를 만든다(=우회).
#    경로만으로 create 를 열면 평상시에도 안 막혀 우회할 대상 자체가 없어진다.
# ⚠️ 부팅 락아웃 주의: 이 정책이 켜진 뒤 스크립트가 이어서 하는 docker login(POST /auth),
#    앱/Watchtower 컨테이너 생성(POST /containers/create), docker info(GET) 가 전부 아래
#    allow 에 걸려야 부팅이 진행된다. GET /info 가 막히면 헬스체크 실패로 daemon.json 이
#    자동 롤백된다(=AuthZ 해제). 아래 규칙은 이 세 가지를 모두 통과시킨다.
# ⚠️ input.Method/Path/Body 스키마·경로는 플러그인 버전(${opa_authz_plugin})에 맞춰 팀이
#    검증할 것. 어긋나면 규칙이 조용히 안 걸려(대개 fail-open) 통제가 무력화된다.
cat > /etc/docker/authz/authz.rego <<'REGO'
package docker.authz

default allow = false

# 상태 조회/검사/로그, 헬스체크(docker info·version·_ping), Watchtower 폴링 — 전부 GET.
allow {
  input.Method == "GET"
}

# 레지스트리 로그인 (private 이미지 pull 전제)
allow {
  input.Method == "POST"
  contains(input.Path, "/auth")
}

# 이미지 pull (Watchtower 갱신)
allow {
  input.Method == "POST"
  contains(input.Path, "/images/create")
}

# 이미지 정리 (WATCHTOWER_CLEANUP=true)
allow {
  input.Method == "DELETE"
  contains(input.Path, "/images/")
}

# 기존 컨테이너 수명주기: 교체 시 stop→rename→start, watchdog 재기동, 제거 등.
# id 로 지정된 '이미 존재하는' 컨테이너 대상 동작만. (exec 은 의도적으로 미포함=거부)
allow {
  input.Method == "POST"
  regex.match(`/containers/[^/]+/(start|stop|restart|kill|wait|rename)`, input.Path)
}
allow {
  input.Method == "DELETE"
  contains(input.Path, "/containers/")
}

# 컨테이너 '생성'은 본문이 안전할 때만 허용 — 여기가 CVE 우회 지점이다.
# privileged 도 아니고 호스트 루트('/') 바인드도 없을 때만 통과.
# (Watchtower 의 /var/run/docker.sock, 앱의 firebase/localtime 마운트는 루트 바인드가
#  아니므로 정상 통과한다. privileged 나 '/:' 바인드는 규칙 불충족 → 기본 거부로 차단.)
allow {
  input.Method == "POST"
  contains(input.Path, "/containers/create")
  not privileged
  not host_root_bind
}

privileged {
  input.Body.HostConfig.Privileged == true
}

host_root_bind {
  some b
  startswith(input.Body.HostConfig.Binds[b], "/:")
}
REGO

# 관리형 플러그인 install(비대화식 부팅이라 권한 자동 승인). 정책 파일을 가리키게 한다.
docker plugin install ${opa_authz_plugin} \
  opa-args="-policy-file /opa/authz.rego" \
  --grant-all-permissions \
  || echo "WARN: AuthZ 플러그인 install 실패. daemon.json 은 그대로 둔다."

# 플러그인이 "확실히 enabled" 일 때만 데몬에 물린다. 아니면 손대지 않아 락아웃을 피한다.
if docker plugin inspect ${opa_authz_plugin} --format '{{.Enabled}}' 2>/dev/null | grep -qx true; then
  cat > /etc/docker/daemon.json <<DAEMON
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },
  "authorization-plugins": ["${opa_authz_plugin}"]
}
DAEMON
  systemctl restart docker
  sleep 3
  # 반영 직후 데몬이 응답하지 않으면(정책 미로딩 등으로 authz 가 전부 deny) 롤백한다.
  if ! docker info >/dev/null 2>&1; then
    echo "FATAL(복구): AuthZ 반영 후 데몬 비정상 → daemon.json 롤백."
    cat > /etc/docker/daemon.json <<'DAEMON'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
DAEMON
    systemctl restart docker
  else
    echo "AuthZ: ${opa_authz_plugin} 데몬에 반영 완료."
  fi
else
  echo "WARN: AuthZ 플러그인이 enabled 가 아니다 → daemon.json 유지(락아웃 회피). user-data.log 확인."
fi
%{ endif ~}

# ------------------------------------------------------------------
# AWS CLI v2 (SSM 에서 Docker Hub 토큰을 읽는 용도)
# Ubuntu apt 의 awscli 는 v1 이라 낡았다.
# ------------------------------------------------------------------
curl -sS "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

# ------------------------------------------------------------------
# Docker Hub 로그인
#
# 대상 저장소가 private 이므로 로그인은 선택이 아니라 필수다.
# 실패하면 아래 컨테이너가 이미지를 못 받아 30 초마다 재시도만 하게 된다.
#
# 토큰을 user_data 에 직접 넣지 않는다. user_data 는 인스턴스 메타데이터로
# 노출되어 인스턴스 내 아무 프로세스나 평문으로 읽을 수 있기 때문이다.
# DB 비밀번호와 같은 방식으로 SSM SecureString 에서 가져온다 (secrets.tf 참고).
#
# ECR 과 달리 Docker Hub PAT 은 만료되지 않으므로 갱신 타이머가 필요 없다.
#
# docker login 은 config.json 을 새로 써서 교체한다(아이노드가 바뀐다).
# 따라서 watchtower 에는 파일이 아니라 디렉터리를 마운트해야 한다.
# ------------------------------------------------------------------
mkdir -p /root/.docker

DOCKERHUB_TOKEN=$(aws ssm get-parameter --name "${dockerhub_token_param}" --with-decryption \
  --region ${region} --query Parameter.Value --output text)

if [ -z "$DOCKERHUB_TOKEN" ] || [ "$DOCKERHUB_TOKEN" = "None" ]; then
  echo "FATAL: Docker Hub 토큰이 비어 있다. private 저장소라 pull 이 불가능하다."
else
  echo "$DOCKERHUB_TOKEN" | docker login --username "${dockerhub_username}" --password-stdin \
    || echo "FATAL: docker login 실패. 토큰 값과 권한(Read)을 확인할 것."
fi

# ------------------------------------------------------------------
# WEB 컨테이너
#
# 이미지가 아직 Docker Hub 에 없어도(최초 apply 가 CI 보다 먼저인 경우) 죽지
# 않고 30 초마다 재시도한다. WAS 의 jar 재시도와 같은 방식이다.
# 즉 인프라를 먼저 올려두고 나중에 파이프라인을 돌려도 알아서 붙는다.
#
# NLB_DNS 를 환경변수로 넘기는 이유:
#   내부 NLB 주소는 Terraform 이 apply 할 때 정해지는데, 이미지는 GitHub
#   Actions 가 빌드하므로 그 값을 알 수 없다. 그래서 이미지에는 nginx 설정
#   "템플릿" 만 넣고, 컨테이너가 뜰 때 envsubst 로 주소를 채운다.
#   (nginx 공식 이미지가 /etc/nginx/templates/*.template 를 자동 처리한다)
#
# DNS_RESOLVER 를 함께 넘기는 이유:
#   nginx 가 proxy_pass 에 호스트명을 직접 쓰면 기동 시 1 회만 DNS 를 조회하고
#   결과를 영구 캐시한다. NLB 는 IP 가 바뀔 수 있어 변수 + resolver 로 매번
#   재조회하게 해야 하는데, 그러려면 resolver 주소를 명시해야 한다.
#
#   ⚠️ 링크로컬 주소(169.254.169.253)를 쓰면 안 된다.
#     호스트에서는 동작하지만 컨테이너의 브리지 네트워크에서는 라우팅되지 않는다.
#     VPC DNS 는 "VPC 대역 + 2" 에도 같은 서비스를 제공하고 이쪽은 일반
#     라우팅되는 주소라 컨테이너에서도 닿는다. compute.tf 가 cidrhost 로 계산해 넘긴다.
#
# watchtower 라벨이 붙은 컨테이너만 갱신 대상이 된다.
# ------------------------------------------------------------------
# ⚠️ 컨테이너 시각과 타임존
# 컨테이너는 호스트 커널의 시계를 그대로 공유한다. 즉 "시각" 자체는 위의
# chrony 로 이미 맞춰져 있고, 컨테이너 안에서 따로 NTP 를 돌릴 필요도 없다
# (애초에 컨테이너에는 시계를 바꿀 권한이 없다).
# 어긋나는 것은 타임존뿐이다. 이미지 안의 기본값은 UTC 라, 손대지 않으면
# 호스트 journalctl 은 KST 인데 nginx access log 만 9 시간 뒤로 찍힌다.
# 그래서 아래 두 가지를 함께 넘긴다.
#   TZ             : glibc 가 우선해서 읽는 값. 다만 이미지에 tzdata 가 없으면
#                    (alpine 계열) 이름을 해석하지 못하고 조용히 UTC 로 떨어진다.
#   /etc/localtime : 그 경우의 보험. 호스트의 zoneinfo 파일을 읽기 전용으로
#                    태운다. 호스트가 timedatectl 로 이미 갈아 둔 그 파일이다.
# 둘 다 이미지를 바꾸지 않으므로 Watchtower 의 컨테이너 교체와 무관하다.
#
# ⚠️ RestartSec 을 짧게 두지 말 것.
# 이미지가 아직 Docker Hub 에 없으면 docker run 이 매번 pull 을 시도하고,
# 그 하나하나가 레지스트리 인증 요청이 된다. 30 초로 뒀을 때 4 대 합쳐
# 분당 8 회를 두드렸고, 토큰을 교체하는 순간 그게 전부 "실패한 로그인" 으로
# 집계되어 Docker Hub 가 계정을 차단했다:
#   toomanyrequests: too many failed login attempts for username or IP address
# 300 초면 분당 0.8 회로 떨어진다. 이미지가 올라오면 첫 시도에 성공하므로
# 이 간격은 "아직 배포 전" 구간에서만 의미가 있다.
cat > /etc/systemd/system/careguard-web.service <<UNIT
[Unit]
Description=careguard web (nginx + React dist)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/docker rm -f careguard-web
ExecStart=/usr/bin/docker run -d \\
  --name careguard-web \\
  --restart unless-stopped \\
  -p 80:80 \\
  -e NLB_DNS=${nlb_dns} \\
  -e DNS_RESOLVER=${dns_resolver} \\
  -e TZ=${timezone} \\
  -v /etc/localtime:/etc/localtime:ro \\
  -l com.centurylinklabs.watchtower.enable=true \\
  ${dockerhub_image}:latest
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable careguard-web
systemctl start careguard-web || echo "WARN: 이미지 없음. 30 초마다 재시도한다."

# ------------------------------------------------------------------
# Watchtower
#
# WATCHTOWER_LABEL_ENABLE=true : 라벨이 붙은 컨테이너만 본다.
#   이게 없으면 watchtower 가 자기 자신까지 갱신 대상으로 삼는다.
# DOCKER_CONFIG=/config       : 위에서 로그인한 자격증명을 읽는다.
# WATCHTOWER_CLEANUP=true     : 교체 후 옛 이미지를 지운다.
#
# ⚠️ 폴링 주기와 Docker Hub rate limit
#   Watchtower 는 폴링할 때마다 매니페스트를 조회하고, Docker Hub 는 이걸
#   pull 로 계산한다. WEB 2 대가 각자 폴링하므로 요청량이 두 배가 된다.
#   60 초로 두면 시간당 120 회라 무료 계정 한도를 넘긴다.
#   기본값을 300 초(시간당 24 회)로 잡은 이유다. variables.tf 주석 참고.
#
# 시작 지연(stagger):
#   WEB 2 대가 동시에 컨테이너를 교체하면 그 몇 초 동안 양쪽 다 502 가 된다.
#   ALB 헬스체크(interval 30 x unhealthy 3 = 90 초)로는 감지도 안 되는
#   짧은 창이라 타깃에서 빠지지도 않는다.
#   호스트명 해시로 0~119 초를 흩어 두 인스턴스의 폴링 주기를 어긋나게 한다.
# ------------------------------------------------------------------
STAGGER=$(( $(hostname | cksum | cut -d' ' -f1) % 120 ))
echo "watchtower stagger: $STAGGER seconds"
sleep "$STAGGER"

docker run -d \
  --name watchtower \
  --restart unless-stopped \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /root/.docker:/config \
  -e DOCKER_CONFIG=/config \
  -e WATCHTOWER_POLL_INTERVAL=${watchtower_poll_interval} \
  -e WATCHTOWER_CLEANUP=true \
  -e WATCHTOWER_LABEL_ENABLE=true \
  -e TZ=${timezone} \
  ${watchtower_image}
