#!/bin/bash
set -uxo pipefail
exec > /var/log/user-data.log 2>&1

# ==================================================================
# WEB 부팅 스크립트 (Docker Hub + Watchtower 기반 CI/CD)
#
# 배포 시퀀스:
#   1) main 에 push
#   2) GitHub Actions 가 이미지 빌드 -> Docker Hub 에 :latest 푸시
#   3) 각 WEB 인스턴스의 Watchtower 가 폴링으로 다이제스트 변경 감지
#   4) 새 이미지 pull 후 컨테이너 교체
#
# 이 스크립트는 부팅 시 두 가지만 한다.
#   - Docker 설치 + Docker Hub 로그인
#   - web 컨테이너와 watchtower 컨테이너 기동
# 이후 배포는 Terraform 과 무관하게 GitHub 쪽에서만 돌아간다.
#
# ⚠️ IMDS hop limit 주의
#   compute.tf 의 imds_v2.http_put_response_hop_limit = 1 이다.
#   컨테이너 내부(브리지 네트워크)에서 169.254.169.254 를 호출하면 홉이 하나
#   늘어 실패한다. 이 설계는 AWS 호출(ssm get-parameter)을 전부 호스트에서
#   하고 컨테이너에는 결과만 넘기므로 1 로 충분하다.
#   컨테이너 안에서 aws CLI 나 SDK 를 쓰게 되면 그때 2 로 올려야 한다.
# ==================================================================

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl gnupg unzip

# ------------------------------------------------------------------
# Docker (공식 저장소)
# Ubuntu 기본 저장소의 docker.io 는 버전이 낡아 공식 저장소를 쓴다.
# ------------------------------------------------------------------
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg |
  gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] \
https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io

# ------------------------------------------------------------------
# 컨테이너 로그 로테이션
#
# Docker 기본 json-file 드라이버는 크기 제한이 없다. nginx access log 가
# stdout 으로 나가 그대로 쌓이므로, 두면 30GB 루트 볼륨이 결국 찬다.
# WATCHTOWER_CLEANUP 은 옛 "이미지" 만 지우지 로그는 건드리지 않는다.
#
# 컨테이너당 최대 30MB(10MB x 3)로 제한한다.
# daemon.json 은 데몬 기동 시 읽히므로 restart 가 필요하다.
# ------------------------------------------------------------------
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'DAEMON'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
DAEMON

systemctl enable docker
systemctl restart docker

# ------------------------------------------------------------------
# AWS CLI v2 (SSM 에서 Docker Hub 토큰을 읽는 용도)
# Ubuntu apt 의 awscli 는 v1 이라 낡았다.
# ------------------------------------------------------------------
curl -sS "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

# ------------------------------------------------------------------
# Docker Hub 로그인
#
# 대상 저장소가 private 이므로 로그인은 선택이 아니라 필수다.
# 실패하면 아래 컨테이너가 이미지를 못 받아 30 초마다 재시도만 하게 된다.
#
# 토큰을 user_data 에 직접 넣지 않는다. user_data 는 인스턴스 메타데이터로
# 노출되어 인스턴스 내 아무 프로세스나 평문으로 읽을 수 있기 때문이다.
# DB 비밀번호와 같은 방식으로 SSM SecureString 에서 가져온다 (secrets.tf 참고).
#
# ECR 과 달리 Docker Hub PAT 은 만료되지 않으므로 갱신 타이머가 필요 없다.
#
# docker login 은 config.json 을 새로 써서 교체한다(아이노드가 바뀐다).
# 따라서 watchtower 에는 파일이 아니라 디렉터리를 마운트해야 한다.
# ------------------------------------------------------------------
mkdir -p /root/.docker

DOCKERHUB_TOKEN=$(aws ssm get-parameter --name "${dockerhub_token_param}" --with-decryption \
  --region ${region} --query Parameter.Value --output text)

if [ -z "$DOCKERHUB_TOKEN" ] || [ "$DOCKERHUB_TOKEN" = "None" ]; then
  echo "FATAL: Docker Hub 토큰이 비어 있다. private 저장소라 pull 이 불가능하다."
else
  echo "$DOCKERHUB_TOKEN" | docker login --username "${dockerhub_username}" --password-stdin \
    || echo "FATAL: docker login 실패. 토큰 값과 권한(Read)을 확인할 것."
fi

# ------------------------------------------------------------------
# WEB 컨테이너
#
# 이미지가 아직 Docker Hub 에 없어도(최초 apply 가 CI 보다 먼저인 경우) 죽지
# 않고 30 초마다 재시도한다. WAS 의 jar 재시도와 같은 방식이다.
# 즉 인프라를 먼저 올려두고 나중에 파이프라인을 돌려도 알아서 붙는다.
#
# NLB_DNS 를 환경변수로 넘기는 이유:
#   내부 NLB 주소는 Terraform 이 apply 할 때 정해지는데, 이미지는 GitHub
#   Actions 가 빌드하므로 그 값을 알 수 없다. 그래서 이미지에는 nginx 설정
#   "템플릿" 만 넣고, 컨테이너가 뜰 때 envsubst 로 주소를 채운다.
#   (nginx 공식 이미지가 /etc/nginx/templates/*.template 를 자동 처리한다)
#
# watchtower 라벨이 붙은 컨테이너만 갱신 대상이 된다.
# ------------------------------------------------------------------
cat > /etc/systemd/system/careguard-web.service <<UNIT
[Unit]
Description=careguard web (nginx + React dist)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/docker rm -f careguard-web
ExecStart=/usr/bin/docker run -d \\
  --name careguard-web \\
  --restart unless-stopped \\
  -p 80:80 \\
  -e NLB_DNS=${nlb_dns} \\
  -l com.centurylinklabs.watchtower.enable=true \\
  ${dockerhub_image}:latest
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable careguard-web
systemctl start careguard-web || echo "WARN: 이미지 없음. 30 초마다 재시도한다."

# ------------------------------------------------------------------
# Watchtower
#
# WATCHTOWER_LABEL_ENABLE=true : 라벨이 붙은 컨테이너만 본다.
#   이게 없으면 watchtower 가 자기 자신까지 갱신 대상으로 삼는다.
# DOCKER_CONFIG=/config       : 위에서 로그인한 자격증명을 읽는다.
# WATCHTOWER_CLEANUP=true     : 교체 후 옛 이미지를 지운다.
#
# ⚠️ 폴링 주기와 Docker Hub rate limit
#   Watchtower 는 폴링할 때마다 매니페스트를 조회하고, Docker Hub 는 이걸
#   pull 로 계산한다. WEB 2 대가 각자 폴링하므로 요청량이 두 배가 된다.
#   60 초로 두면 시간당 120 회라 무료 계정 한도를 넘긴다.
#   기본값을 300 초(시간당 24 회)로 잡은 이유다. variables.tf 주석 참고.
#
# 시작 지연(stagger):
#   WEB 2 대가 동시에 컨테이너를 교체하면 그 몇 초 동안 양쪽 다 502 가 된다.
#   ALB 헬스체크(interval 30 x unhealthy 3 = 90 초)로는 감지도 안 되는
#   짧은 창이라 타깃에서 빠지지도 않는다.
#   호스트명 해시로 0~119 초를 흩어 두 인스턴스의 폴링 주기를 어긋나게 한다.
# ------------------------------------------------------------------
STAGGER=$(( $(hostname | cksum | cut -d' ' -f1) % 120 ))
echo "watchtower stagger: $STAGGER seconds"
sleep "$STAGGER"

docker run -d \
  --name watchtower \
  --restart unless-stopped \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /root/.docker:/config \
  -e DOCKER_CONFIG=/config \
  -e WATCHTOWER_POLL_INTERVAL=${watchtower_poll_interval} \
  -e WATCHTOWER_CLEANUP=true \
  -e WATCHTOWER_LABEL_ENABLE=true \
  containrrr/watchtower
